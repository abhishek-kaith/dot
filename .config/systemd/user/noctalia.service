# Noctalia for the niri session (from Noctalia's docs; 5.4.1 doesn't ship it).
# Restarts on crash; lets launched apps get their own cgroup.
[Unit]
Description=Noctalia shell
Documentation=https://docs.noctalia.dev/noctalia/compositor-settings/systemd-service/
PartOf=graphical-session.target
After=niri.service
Requisite=niri.service
Before=graphical-session.target

[Service]
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=niri.service
