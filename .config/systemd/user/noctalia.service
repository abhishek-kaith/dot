# Noctalia shell for the niri session only (not in other desktops).
# Based on the user service in Noctalia's docs ("Noctalia systemd user service");
# Noctalia 5.4.1 doesn't ship the file yet. Type=simple: 5.4.1's notify support
# isn't confirmed, so readiness isn't waited for.
# Running as a unit lets launch_apps_as_systemd_services put each app in its own
# cgroup, and systemd restarts the bar if it crashes.
# Enabled by ~/.setup/install.sh niri.
[Unit]
Description=Noctalia shell
Documentation=https://docs.noctalia.dev/noctalia/compositor-settings/systemd-service/
PartOf=graphical-session.target
After=niri.service
Requisite=niri.service
Before=graphical-session.target

[Service]
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=niri.service
