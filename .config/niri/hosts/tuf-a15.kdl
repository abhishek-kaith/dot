// ASUS TUF Gaming A15: Radeon 740M drives the panel and USB-C, the RTX 3050
// drives HDMI. Linked as ../host.kdl on this machine by ~/.setup/install.sh.

// Laptop panel: 1920x1080, 48-144 Hz (EDID). No refresh given = the highest.
// VRR: refresh follows content, 144 Hz while things move, down to 48 Hz idle.
// If the panel flickers near 48 Hz, use `variable-refresh-rate on-demand=true`
// and a `variable-refresh-rate true` window rule for games and video only.
output "eDP-1" {
    mode "1920x1080"
    scale 1
    variable-refresh-rate
}

// Render on the AMD iGPU, not the NVIDIA one (else ~13 W more at idle).
// by-path follows the PCI address, so it cannot swap like renderD128/129.
// 0000:05:00.0 = Radeon 740M, 0000:01:00.0 = RTX 3050.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:05:00.0-render"
}

// NVIDIA GPU: niri leaves it alone by default, so it never keeps it awake and
// `gpu-mode eco|hybrid` switches without logging out. The cost: no HDMI (it is
// wired to the NVIDIA GPU; USB-C displays work). `gpu-mode hdmi on|off` writes
// ../nvidia.kdl (not tracked; created by ~/.setup/tuf-a15.sh), then log out and in.
include optional=true "nvidia.kdl"
