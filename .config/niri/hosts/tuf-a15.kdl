// tuf-a15: panel + USB-C on the Radeon 740M, HDMI on the RTX 3050.

// 48-144 Hz panel with VRR (flicker? use `variable-refresh-rate on-demand=true`).
output "eDP-1" {
    mode "1920x1080"
    scale 1
    variable-refresh-rate
}

// Render on AMD (05:00.0), not NVIDIA (01:00.0): ~13 W less at idle.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:05:00.0-render"
}

// Written by `gpu-mode hdmi off|auto` (not tracked).
include optional=true "nvidia.kdl"
