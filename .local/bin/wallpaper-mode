#!/bin/sh
# wallpaper-mode: a dark and a light wallpaper that follow Noctalia's theme mode.
# Noctalia runs this on every dark/light switch (hooks.theme_mode_changed in
# ~/.config/noctalia/config.toml); it passes the modes in NOCTALIA_THEME_MODE
# and NOCTALIA_THEME_MODE_PREVIOUS.
#
# The wallpaper you had is remembered for the mode you left, and the one last
# used in the new mode comes back. The defaults are set by install.sh niri
# (~/.local/state/wallpaper-mode/{dark,light}); without one, the first image in
# ~/Pictures/Wallpapers/{Dark,Light} is used.
#   wallpaper-mode            what Noctalia calls
#   wallpaper-mode dark|light apply that mode's wallpaper by hand
set -eu

new=${1:-${NOCTALIA_THEME_MODE:-}}
old=${NOCTALIA_THEME_MODE_PREVIOUS:-}
case $new in
    dark | light) ;;
    *) echo "usage: wallpaper-mode [dark|light]" >&2; exit 1 ;;
esac

state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-mode"
mkdir -p "$state"

# Remember what was on screen for the mode we're leaving.
if [ "$old" = dark ] || [ "$old" = light ]; then
    current=$(noctalia msg wallpaper-get 2>/dev/null || true)
    [ -f "$current" ] && printf '%s\n' "$current" >"$state/$old"
fi

target=
[ -f "$state/$new" ] && target=$(cat "$state/$new")
if [ ! -f "$target" ]; then
    case $new in dark) dir=Dark ;; light) dir=Light ;; esac
    target=$(find -L "$HOME/Pictures/Wallpapers/$dir" -maxdepth 1 -type f | sort | head -n1)
fi
[ -f "$target" ] || { echo "no wallpaper for $new mode" >&2; exit 1; }

noctalia msg wallpaper-set "$target"
