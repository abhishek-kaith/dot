#!/bin/sh
# wallpaper-mode [dark|light]: switch to that mode's wallpaper. Noctalia runs it
# on every dark/light switch (theme_mode_changed hook). Remembers the last pick
# per mode in ~/.local/state/wallpaper-mode/.
set -eu

new=${1:-${NOCTALIA_THEME_MODE:-}}
old=${NOCTALIA_THEME_MODE_PREVIOUS:-}
case $new in
    dark | light) ;;
    *) echo "usage: wallpaper-mode [dark|light]" >&2; exit 1 ;;
esac

state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-mode"
mkdir -p "$state"

# Remember what was on screen for the mode we're leaving.
if [ "$old" = dark ] || [ "$old" = light ]; then
    current=$(noctalia msg wallpaper-get 2>/dev/null || true)
    [ -f "$current" ] && printf '%s\n' "$current" >"$state/$old"
fi

target=
[ -f "$state/$new" ] && target=$(cat "$state/$new")
if [ ! -f "$target" ]; then
    case $new in dark) dir=Dark ;; light) dir=Light ;; esac
    target=$(find -L "$HOME/Pictures/Wallpapers/$dir" -maxdepth 1 -type f | sort | head -n1)
fi
[ -f "$target" ] || { echo "no wallpaper for $new mode" >&2; exit 1; }

noctalia msg wallpaper-set "$target"
